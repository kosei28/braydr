                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "loop {\n  let job = queue.peek()?;\n  match deliver(&job) {\n    Ok(()) => queue.pop(),\n    Err(_) if job.tries < 3 => job.retry(),\n    Err(_) => return Err(Stuck),\n  }\n}",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 12.5,
                                  "fontWeight": "normal"
